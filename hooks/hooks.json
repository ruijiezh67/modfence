{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/plugin/cli.py\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/plugin/cli.py\" jit --hook",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python; command -v python >/dev/null 2>&1 || P=python3; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/plugin/cli.py\" receipt --hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
